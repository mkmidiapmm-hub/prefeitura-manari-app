# Páginas públicas em destaque.
/
  Link: <https://www.manari.pe.gov.br/>; rel="canonical"
/localizacao
  Link: <https://www.manari.pe.gov.br/localizacao>; rel="canonical"
/ouvidoria/
  Link: <https://www.manari.pe.gov.br/ouvidoria/>; rel="canonical"
/noticias
  Link: <https://www.manari.pe.gov.br/noticias>; rel="canonical"
/transparencia/
  Link: <https://www.manari.pe.gov.br/transparencia/>; rel="canonical"

# Áreas de trabalho e páginas desativadas não são atalhos públicos de busca.
/gestao-demandas/*
  X-Robots-Tag: noindex, nofollow
/protocolo/*
  X-Robots-Tag: noindex, nofollow
/esic/redefinir-senha/*
  X-Robots-Tag: noindex, nofollow
/v1/*
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex

# A Educação deve revalidar o painel e seus módulos em cada acesso.
/educacao/*
  Cache-Control: no-store, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/galeria
  Link: <https://www.manari.pe.gov.br/galeria>; rel="canonical"
  Cache-Control: no-cache
